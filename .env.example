# Copy to .env at the repository root and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# The ERP database — restored from the production dump. Read for identity,
# written only by the projection.
DB_NAME=fusionlab
DB_USER=fusion_admin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# The IAM's own database. Separate so that restoring the ERP dump cannot take
# the operator accounts and the audit trail with it.
#   createdb -U fusion_admin fusion_system_db
SYSTEM_DB_NAME=fusion_system_db
SYSTEM_DB_USER=fusion_admin
SYSTEM_DB_PASSWORD=
SYSTEM_DB_HOST=localhost
SYSTEM_DB_PORT=5432

# Each service needs a cookie name of its own. Share one and logging into the
# second service logs you out of the first.
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=Lax
TOKEN_TTL_HOURS=12

# Where the console is mounted. "/" in development, "/sysadmin/" behind nginx.
APP_BASE_PATH=/

# Set both in production, behind TLS.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Empty means local-memory cache, which is fine for a single dev process.
REDIS_URL=

# Refuse a designation the holder's basic role may not hold, rather than only
# reporting it. Start a new deployment on False, read iam_role_violation, then
# switch it on once the catalogue matches how the institute actually works.
IAM_ENFORCE_ROLE_POLICY=False

# Encrypts database backups. Without it they are written in the clear.
BACKUP_ENCRYPTION_KEY=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
